# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# Comma-separated browser origins allowed to call the API. Use origins only, without a path.
# @type=string(minLength=1)
CORS_ORIGIN=

# Comma-separated emails allowed to sign in and sign up. These accounts can also open and scan
# every page. Sign-up does not verify email, so only list addresses you control.
# An empty list blocks all sign-in and sign-up.
# @optional
PAGE_OPERATOR_EMAILS=

# ISO 4217 currency that scans try to show: geo-IP lookups are blocked and a currency
# switcher on the page is set to it. Defaults to EUR.
# @optional @sensitive=false
PRICING_CAPTURE_CURRENCY=

# Accept-Language header sent with every scan. Defaults to en-IE,en;q=0.9.
# @optional @sensitive=false
PRICING_CAPTURE_LANGUAGE=
